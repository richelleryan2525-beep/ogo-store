# MongoDB Atlas connection string
# Create a free cluster at https://www.mongodb.com/cloud/atlas
# Database user needs read/write access; whitelist your deploy host's IP (or 0.0.0.0/0 for testing)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/ogo?retryWrites=true&w=majority

# Long random string used to sign admin login sessions (JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=replace-with-a-long-random-string

# Used once by `npm run seed` to create the first ERP admin account.
# Change the password immediately after first login.
ADMIN_SEED_NAME=Store Admin
ADMIN_SEED_EMAIL=admin@ogo.example
ADMIN_SEED_PASSWORD=change-this-password

# Public site URL, used for SEO metadata, sitemap.xml and tracking links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store display info
NEXT_PUBLIC_STORE_NAME=ÒGO
NEXT_PUBLIC_STORE_WHATSAPP=2348000000000

# Optional: free Lagos delivery threshold in Naira
FREE_LAGOS_DELIVERY_OVER=150000
